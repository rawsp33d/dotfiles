(defhands
	(left  tab q w e r t caps a s d f g lsft z x c v b)
	(right y u i o p [ ] \ h j k l ; ' ret n m , . / rsft)
)

(deftemplate hrm (tap hold neutral)
	(tap-hold-opposite-hand-release $hold-timeout $tap $hold (timeout hold) (unknown-hand hold) (require-prior-idle 150) $neutral (neutral hold))
)

(defalias
	erm (layer-switch ermak)

	;; super+shift skips the shifted layer
	lsft (fork (multi lsft (layer-while-held ermak-shifted)) lsft (lmet rmet))
	rsft (fork (multi rsft (layer-while-held ermak-shifted)) rsft (lmet rmet))
	osr (multi (one-shot $one-shot rsft) (one-shot $one-shot (layer-while-held ermak-shifted)))

	xsy (tap-hold-release $tap-timeout $hold-timeout tab (layer-while-held sym))
	xnv (tap-hold-release $tap-timeout $hold-timeout ret (layer-while-held nav))

	xcp (tap-hold-release $tap-timeout $hold-timeout esc lctl)
	xsu (tap-hold-release $tap-timeout $hold-timeout M-A-spc lmet)
	xtp (tap-hold-release $tap-timeout $hold-timeout C-spc ctl)

	xss (fork
		(fork
			(fork
				(cmd nu -c "~/bin/screenshot select")
				(cmd nu -c "~/bin/screenshot full")
				(lctl rctl)
			)
			(cmd nu -c "~/bin/screenshot window")
			(lalt ralt)
		)
		(cmd nu -c "~/bin/screenshot screen")
		(lsft rsft)
	)

	hml (t! hrm g lmet (neutral-keys x c v))
	hal (t! hrm x lalt (neutral-keys z c v f))
	hcl (t! hrm j lctl (neutral-keys z x v))
	hsl (t! hrm k @lsft (neutral-keys z x c a))
	hsr (t! hrm r @rsft (neutral-keys , . /))
	hcr (t! hrm m rctl (neutral-keys m . /))
	har (t! hrm f ralt (neutral-keys m , /))
	hmr (t! hrm p rmet (neutral-keys m , .))
)

(deflayer ermak
	_     _    _    _    _    _    _    _    _    _    _    _     _       @xss _    @gam
	[     _    _    _    _    _    _    _    _    _    _    ]     `   _   _    _    _     _    _    _    _
	_     b    y    o    u    '    S-'  l    d    w    v    z     S-/ S-3 _    _    _     _    _    _    _
	@xcp  c    i    e    a    ,    .    h    t    s    n    q     _                       _    _    _
	@lsft @hml @hal @hcl @hsl -    /    @hsr @hcr @har @hmr @osr               _          _    _    _    _
	_     @lyr @xsy           _              @xsu _    @spr @xnv          _    _    _     _    _

	#| mute  |# (cmd nu -c "~/bin/cfg volume !")
	#| volu  |# (cmd nu -c "~/bin/cfg volume +5")
	#| vold  |# (cmd nu -c "~/bin/cfg volume -5")
	#| brup  |# (cmd nu -c "~/bin/cfg brightness +10")
	#| brdn  |# (cmd nu -c "~/bin/cfg brightness -10")
	#| blup  |# _
	#| bldn  |# _
	#| next  |# (cmd playerctl --player=%any,chromium next)
	#| pp    |# (cmd playerctl --player=%any,chromium play-pause)
	#| prev  |# (cmd playerctl --player=%any,chromium previous)
	#| plyr  |# _
	#| power |# _
	#| sleep |# _
	#| f13   |# (cmd rofi -show drun -display-drun launch)
	#| f14   |# (cmd notify-send f14)
	#| f15   |# _
	#| f16   |# (cmd notify-send f16)
	#| f17   |# (fork
								(fork
									(cmd nu -c "~/bin/locker -rS")
									(cmd nu -c "~/bin/locker -b")
									(lctl rctl)
								)
								(cmd nu -c "~/bin/locker -s")
								(lsft rsft)
							)
	#| f18   |# (cmd notify-send f18)
	#| f19   |# (cmd notify-send f19)
	#| f20   |# (cmd notify-send f20)
	#| f21   |# (cmd notify-send f21)
	#| f22   |# (cmd notify-send f22)
	#| f23   |# (cmd notify-send f23)
	#| f24   |# (cmd notify-send f24)
	#| mlft  |# _
	#| mrgt  |# _
	#| mmid  |# _
	#| mfwd  |# _
	#| mbck  |# _
)

(deflayer ermak-shifted
	_    _           _           _    _    _           _    _    _    _    _    _    _          _    _    _
	_    (unshift \) (unshift =) `    =    ,           .    6    7    5    8    _    4    _     _    _    _     _    _    _    _
	_    _           _           _    _    9           0    _    _    _    _    _    1    2     _    _    _     _    _    _    _
	_    _           _           _    _    (unshift ;) ;    _    _    _    _    _    _                          _    _    _
	_    _           _           _    _    -           \    _    _    _    _    _                    _          _    _    _    _
	_    _           _                     _                     _    _    _    _               _    _    _     _    _

	_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
)

